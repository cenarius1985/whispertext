# WISPER-TEXT — variables de entorno (copiar a .env y ajustar)
# Sin secretos reales: valores de desarrollo local solamente.

# --- PostgreSQL (compose) ---
POSTGRES_USER=wispertext
POSTGRES_PASSWORD=cambia-me-dev
POSTGRES_DB=wispertext

# --- Puertos host (cambiar si están ocupados) ---
API_PORT=8000
FRONTEND_PORT=3000
# URL pública de la API que usa el navegador (se "hornea" en el build del frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Bonsai (LLM local; fail-soft) ---
# main = CPU-first (default): servicio externo existente (anythingllm-bonsai :4687)
BONSAI_BASE_URL=http://host.docker.internal:4687/v1
BONSAI_MODEL=ternary-bonsai-8b
# Con GPU NVIDIA (rama `gpu`, afinada RTX 4060 8 GB): el coordinador lo detecta
# y genera este bloque automáticamente — o actívalo a mano:
#   BONSAI_BASE_URL=http://bonsai:8080/v1
#   BONSAI_MODEL=ternary-bonsai-2-27b
#   BONSAI_NGL=99
#   BONSAI_THINKING=1             # razonamiento (más calidad, mucho más lento)
#   BONSAI_REASONING_BUDGET=768   # con THINKING=1, acota tokens de razonamiento
#   BONSAI_HF_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
#   BONSAI_GGUF=Ternary-Bonsai-2-27B-PTQ1_0.gguf
BONSAI_ENABLED=true

# --- TTS (Piper) ---
PIPER_VOICE_DEFAULT=es_AR-daniela-high
PIPER_VOICES_EXTRA=en_US-lessac-high,en_US-ryan-high
TTS_FORMAT=mp3
TTS_BITRATE=96k

# --- OCR ---
TESSERACT_LANGS=spa+eng

# --- Misc ---
EXPORT_PAUSE_MS=600
MAX_UPLOAD_MB=200
NORMALIZER_VERSION=v7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
